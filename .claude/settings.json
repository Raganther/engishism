{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/tools/where-are-we.js\" 2>/dev/null || true",
            "timeout": 45,
            "statusMessage": "Asking GitHub where main actually is…"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/tools/shelf.js\" 2>/dev/null || true",
            "timeout": 15,
            "statusMessage": "Checking the shared shelf…"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/tools/which-skill.js\" 2>/dev/null || true",
            "timeout": 15,
            "statusMessage": "Is there a procedure for this?…"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/tools/memory-check.js\" 2>/dev/null || true",
            "timeout": 15,
            "statusMessage": "Checking CLAUDE.md is current…"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/tools/suite-check.js\" 2>/dev/null || true",
            "timeout": 15,
            "statusMessage": "Is this test run worth the wait?…"
          }
        ]
      }
    ]
  }
}
